# Scorigami classification for nfldoinkeR doinks.
#
# A doink is "in a Scorigami" when its game ended in a final score
# (winner points, loser points; ties as x-x) that no NFL game had produced
# before that game's date. Scores come from load_doinks() itself; the score
# history is a local CSV in one of two shapes (see load_history()).
#
# Base R only, apart from nfldoinkeR for the default doink loader.
# First NFL (APFA) game day. A history whose earliest date is after this
# cannot rule out a score that first occurred before its floor.
SCORIGAMI_EPOCH <- as.Date("1920-09-26")
STATUS_CONFIRMED <- "confirmed"
STATUS_SAME_DAY <- "same-day tie"
STATUS_UNDETERMINED <- "undetermined"
# Header aliases, compared after normalize_name(): lower case, letters and
# digits only, so "Pts W", "pts_w" and "PtsW" all become "ptsw".
HISTORY_ALIASES <- list(
date  = c("date", "gamedate", "gameday", "day"),
pts_w = c("ptsw", "winnerpts", "winnerpoints", "winnerscore", "winpts",
"wpts", "pointswinner", "pw", "winningscore", "winscore", "winnerpoint"),
pts_l = c("ptsl", "loserpts", "loserpoints", "loserscore", "losepts",
"lpts", "pointsloser", "pl", "losingscore", "losescore", "loserpoint"),
count = c("count", "n", "games", "numgames", "ngames", "occurrences",
"times", "gamecount"),
first = c("firstgame", "firstdate", "firstgamedate", "firstplayed", "first"),
last  = c("lastgame", "lastdate", "lastgamedate", "mostrecent",
"lastplayed", "last", "mostrecentgame")
)
normalize_name <- function(x) gsub("[^a-z0-9]", "", tolower(x))
# Winner first, loser second; a 20-23 home loss and a 23-20 home win share
# the key "23-20". Ties come out as "x-x".
score_key <- function(a, b) paste0(pmax(a, b), "-", pmin(a, b))
find_column <- function(header, role, override) {
if (!is.null(override[[role]])) {
if (!override[[role]] %in% header) {
stop(sprintf("Column '%s' given for %s is not in the header: %s",
override[[role]], role, paste(header, collapse = ", ")),
call. = FALSE)
}
return(override[[role]])
}
hit <- which(normalize_name(header) %in% HISTORY_ALIASES[[role]])
if (length(hit) > 1L) {
stop(sprintf("More than one column could be %s: %s. Name one with --%s=COLUMN.",
role, paste(header[hit], collapse = ", "), gsub("_", "-", role)),
call. = FALSE)
}
if (length(hit) == 0L) NA_character_ else header[hit]
}
detect_shape <- function(header, override = list()) {
roles <- names(HISTORY_ALIASES)
cols <- stats::setNames(lapply(roles, find_column, header = header,
override = override), roles)
if (is.na(cols$pts_w) || is.na(cols$pts_l)) {
stop(sprintf(paste0(
"Could not find winner and loser points columns in: %s.\n",
"Name them with --pts-w=COLUMN --pts-l=COLUMN."),
paste(header, collapse = ", ")), call. = FALSE)
}
if (!is.na(cols$count)) {
if (is.na(cols$last) && is.na(cols$first)) {
stop("The history has a count column (per-score summary) but no last-game or first-game date column. Name one with --last=COLUMN or --first=COLUMN.",
call. = FALSE)
}
shape <- "B"
} else if (!is.na(cols$date)) {
shape <- "A"
} else {
stop(sprintf(paste0(
"Could not tell the history's shape from its header: %s.\n",
"Shape A needs a game date column; shape B needs a count column."),
paste(header, collapse = ", ")), call. = FALSE)
}
list(shape = shape, cols = cols)
}
# Accepts ISO dates, m/d/Y, and text with a "Month D, YYYY" date in it (as in
# a "last game" cell that reads "Bills vs. Dolphins, October 6, 2024").
# Any non-blank value that will not parse stops the run rather than being
# dropped, because a dropped history row can turn a repeat into a false
# Scorigami.
parse_history_date <- function(x, label) {
if (inherits(x, "Date")) return(x)
x <- trimws(as.character(x))
old <- Sys.getlocale("LC_TIME")
on.exit(Sys.setlocale("LC_TIME", old), add = TRUE)
Sys.setlocale("LC_TIME", "C")
out <- as.Date(rep(NA_character_, length(x)))
try_fmt <- function(v, fmt) suppressWarnings(as.Date(v, format = fmt))
for (fmt in c("%Y-%m-%d", "%m/%d/%Y", "%Y/%m/%d", "%B %d, %Y", "%b %d, %Y",
"%b. %d, %Y", "%d %B %Y")) {
todo <- is.na(out) & nzchar(x) & !is.na(x)
if (!any(todo)) break
out[todo] <- try_fmt(x[todo], fmt)
}
todo <- is.na(out) & nzchar(x) & !is.na(x)
if (any(todo)) {
iso <- regmatches(x[todo], regexpr("[0-9]{4}-[0-9]{2}-[0-9]{2}", x[todo]))
has_iso <- grepl("[0-9]{4}-[0-9]{2}-[0-9]{2}", x[todo])
idx <- which(todo)
out[idx[has_iso]] <- as.Date(iso)
todo <- is.na(out) & nzchar(x) & !is.na(x)
}
if (any(todo)) {
pat <- "[A-Z][a-z]{2,8}\\.? [0-9]{1,2}, [0-9]{4}"
has_txt <- grepl(pat, x[todo])
idx <- which(todo)
txt <- regmatches(x[todo], regexpr(pat, x[todo]))
txt <- sub("\\.", "", txt)
p <- try_fmt(txt, "%B %d, %Y")
p[is.na(p)] <- try_fmt(txt[is.na(p)], "%b %d, %Y")
out[idx[has_txt]] <- p
}
bad <- which(is.na(out))
if (length(bad)) {
stop(sprintf("%d value(s) in the %s column are blank or not dates (data rows %s; e.g. '%s').",
length(bad), label, paste(utils::head(bad, 8), collapse = ", "),
x[bad[1]]), call. = FALSE)
}
# A two-digit year read through %Y lands in the first century; catch it
# here instead of letting year 0024 sit below every real game.
odd <- which(out < as.Date("1900-01-01") | out > Sys.Date() + 1)
if (length(odd)) {
stop(sprintf("%d date(s) in the %s column are out of range (data rows %s; e.g. '%s' read as %s). Two-digit years are not supported.",
length(odd), label, paste(utils::head(odd, 8), collapse = ", "),
x[odd[1]], out[odd[1]]), call. = FALSE)
}
out
}
parse_points <- function(x, label) {
v <- suppressWarnings(as.numeric(as.character(x)))
bad <- which(is.na(v) | v != trunc(v) | v < 0)
if (length(bad)) {
stop(sprintf("%d value(s) in the %s column are not whole non-negative numbers (data rows %s).",
length(bad), label, paste(utils::head(bad, 8), collapse = ", ")),
call. = FALSE)
}
as.integer(v)
}
load_history <- function(path, override = list()) {
if (!file.exists(path)) stop(sprintf("History file not found: %s", path), call. = FALSE)
raw <- utils::read.csv(path, check.names = FALSE, stringsAsFactors = FALSE,
strip.white = TRUE, na.strings = c("", "NA"))
if (!nrow(raw)) stop("The history file has no data rows.", call. = FALSE)
det <- detect_shape(names(raw), override)
cols <- det$cols
w <- parse_points(raw[[cols$pts_w]], cols$pts_w)
l <- parse_points(raw[[cols$pts_l]], cols$pts_l)
swapped <- sum(w < l)
h <- data.frame(row = seq_len(nrow(raw)), pts_w = pmax(w, l), pts_l = pmin(w, l))
h$key <- score_key(h$pts_w, h$pts_l)
if (det$shape == "A") {
h$date <- parse_history_date(raw[[cols$date]], cols$date)
floor <- min(h$date)
ceiling <- max(h$date)
has_first <- NA
} else {
h$count <- parse_points(raw[[cols$count]], cols$count)
has_first <- !is.na(cols$first)
h$first <- if (has_first) parse_history_date(raw[[cols$first]], cols$first) else as.Date(NA)
h$last <- if (!is.na(cols$last)) parse_history_date(raw[[cols$last]], cols$last) else as.Date(NA)
dup <- h$key[duplicated(h$key)]
if (length(dup)) {
stop(sprintf("The per-score summary lists %s more than once.",
paste(unique(dup), collapse = ", ")), call. = FALSE)
}
floor <- if (has_first) min(h$first) else as.Date(NA)
ceiling <- if (!is.na(cols$last)) max(h$last) else max(h$first)
}
list(shape = det$shape, path = path, cols = cols, data = h,
floor = floor, ceiling = ceiling, has_first = has_first,
swapped = swapped)
}
# One row per game in the doink table, keyed by date and teams.
doink_games <- function(d) {
g <- unique(d[, c("game_date", "away_team", "home_team", "away_score", "home_score")])
g$game <- paste(g$game_date, g$away_team, g$home_team)
if (anyDuplicated(g$game)) {
stop("The doink table gives more than one final score for the same game: ",
paste(unique(g$game[duplicated(g$game)]), collapse = "; "), call. = FALSE)
}
g$key <- score_key(g$away_score, g$home_score)
g
}
empty_match <- function() {
list(status = NA_character_, note = NA_character_, row = NA_character_,
date = as.Date(NA), count = NA_integer_, first = as.Date(NA),
last = as.Date(NA), pts_w = NA_integer_, pts_l = NA_integer_,
in_history = NA)
}
# Returns one list per game: status is NA when the game is proven not to be a
# Scorigami, otherwise confirmed / same-day tie / undetermined.
classify_game_A <- function(key, date, h) {
m <- empty_match()
rows <- h[h$key == key, , drop = FALSE]
here <- rows[rows$date == date, , drop = FALSE]
m$in_history <- nrow(here) > 0
if (nrow(here)) {
m$row <- paste(here$row, collapse = ";")
m$date <- date
m$pts_w <- here$pts_w[1]
m$pts_l <- here$pts_l[1]
}
if (any(rows$date < date)) {
return(m)
}
if (nrow(here) >= 2L) {
m$status <- STATUS_SAME_DAY
m$note <- sprintf("%d games first reached this score on the same day", nrow(here))
} else if (nrow(here) == 1L) {
m$status <- STATUS_CONFIRMED
} else {
m$status <- STATUS_UNDETERMINED
m$note <- "game not found in history; no earlier occurrence either"
}
m
}
classify_game_B <- function(key, date, hist) {
h <- hist$data
m <- empty_match()
r <- h[h$key == key, , drop = FALSE]
if (!nrow(r)) {
m$in_history <- FALSE
m$status <- STATUS_UNDETERMINED
m$note <- "score not in summary"
return(m)
}
m$row <- as.character(r$row)
m$count <- r$count
m$first <- r$first
m$last <- r$last
m$pts_w <- r$pts_w
m$pts_l <- r$pts_l
if (hist$has_first) {
m$in_history <- r$first <= date && (is.na(r$last) || r$last >= date)
if (r$first < date) return(m)
if (r$first == date) {
if (r$count >= 2L && !is.na(r$last) && r$last == date) {
m$status <- STATUS_SAME_DAY
m$note <- "every occurrence of this score is on this day"
} else {
m$status <- STATUS_CONFIRMED
}
return(m)
}
m$status <- STATUS_UNDETERMINED
m$note <- "summary's first occurrence is after this game"
return(m)
}
m$in_history <- r$last >= date
if (r$count == 1L && r$last == date) {
m$status <- STATUS_CONFIRMED
} else if (r$count == 1L) {
m$status <- STATUS_UNDETERMINED
m$note <- "count is 1 but the last game is not this game"
} else {
m$status <- STATUS_UNDETERMINED
m$note <- "summary has no first-occurrence date"
}
m
}
classify_games <- function(games, hist) {
res <- lapply(seq_len(nrow(games)), function(i) {
k <- games$key[i]
dt <- games$game_date[i]
m <- if (hist$shape == "A") classify_game_A(k, dt, hist$data) else classify_game_B(k, dt, hist)
# A game after the history's last date cannot be proven new: an unseen
# game between the ceiling and this one may have produced the score.
if (!is.na(m$status) && dt > hist$ceiling) {
m$status <- STATUS_UNDETERMINED
m$note <- sprintf("history ends %s, before this game", hist$ceiling)
}
# Below the floor the history cannot contain the game, so a missing row
# there is coverage, not a score mismatch.
if (!is.na(hist$floor) && dt < hist$floor && identical(m$status, STATUS_UNDETERMINED)) {
m$note <- sprintf("game is before the history floor (%s)", hist$floor)
}
m
})
games$scorigami_status <- vapply(res, `[[`, "", "status")
games$status_note <- vapply(res, `[[`, "", "note")
games$history_row <- vapply(res, `[[`, "", "row")
games$history_date <- do.call(c, lapply(res, `[[`, "date"))
games$history_pts_w <- vapply(res, `[[`, 0L, "pts_w")
games$history_pts_l <- vapply(res, `[[`, 0L, "pts_l")
games$history_count <- vapply(res, `[[`, 0L, "count")
games$history_first_date <- do.call(c, lapply(res, `[[`, "first"))
games$history_last_date <- do.call(c, lapply(res, `[[`, "last"))
games$in_history <- vapply(res, `[[`, NA, "in_history")
games
}
path_description <- function(hist) {
c <- hist$cols
if (hist$shape == "A") {
sprintf("shape A, one row per game (date='%s', pts_w='%s', pts_l='%s'); Scorigami = no row with the same score on an earlier date",
c$date, c$pts_w, c$pts_l)
} else if (hist$has_first) {
sprintf("shape B, per-score summary with first-game date (count='%s', first='%s'); Scorigami = first-game date equals the doink's game date",
c$count, c$first)
} else {
sprintf("shape B, per-score summary with no first-occurrence date (count='%s', last='%s'); only scores with count == 1 whose last game is this game can be proven; every other candidate is undetermined (summary has no first-occurrence date)",
c$count, c$last)
}
}
print_table <- function(x, title) {
cat(title, "\n", sep = "")
if (!length(x)) { cat("  (none)\n"); return(invisible()) }
for (n in names(x)) cat(sprintf("  %-10s %d\n", n, x[[n]]))
}
#' Run the analysis. `doinks` defaults to nfldoinkeR::load_doinks(); tests
#' pass a synthetic table. Returns the qualifying-doink data frame invisibly.
run_scorigami <- function(history_path, out_path = file.path("out", "scorigami_doinks.csv"),
doinks = NULL, override = list()) {
hist <- load_history(history_path, override)
if (is.null(doinks)) doinks <- nfldoinkeR::load_doinks()
d <- as.data.frame(doinks)
need <- c("doink_id", "game_date", "season", "week", "away_team", "home_team",
"away_score", "home_score", "kicking_team", "kicker", "play_type",
"distance", "outcome")
miss <- setdiff(need, names(d))
if (length(miss)) stop("Doink table is missing: ", paste(miss, collapse = ", "), call. = FALSE)
if (anyNA(d$away_score) || anyNA(d$home_score)) {
stop(sum(is.na(d$away_score) | is.na(d$home_score)),
" doink(s) have no final score.", call. = FALSE)
}
games <- classify_games(doink_games(d), hist)
d$game <- paste(d$game_date, d$away_team, d$home_team)
gcols <- setdiff(names(games), c("game_date", "away_team", "home_team",
"away_score", "home_score"))
x <- merge(d, games[, gcols], by = "game", all.x = TRUE, sort = FALSE)
x <- x[order(x$game_date, x$doink_id), ]
q <- x[!is.na(x$scorigami_status), , drop = FALSE]
winner <- ifelse(q$away_score > q$home_score, q$away_team,
ifelse(q$home_score > q$away_score, q$home_team, "TIE"))
out <- data.frame(
doink_id = q$doink_id,
game_date = format(q$game_date),
season = q$season,
week = q$week,
matchup = paste0(q$away_team, rep(" @ ", nrow(q)), q$home_team),
final_score = q$key,
winner = winner,
kicking_team = q$kicking_team,
kicker = q$kicker,
play_type = q$play_type,
distance = q$distance,
outcome = q$outcome,
scorigami_status = q$scorigami_status,
status_note = q$status_note,
history_source = rep(basename(hist$path), nrow(q)),
history_shape = rep(hist$shape, nrow(q)),
history_row = q$history_row,
history_date = format(q$history_date),
history_pts_w = q$history_pts_w,
history_pts_l = q$history_pts_l,
history_count = q$history_count,
history_first_date = format(q$history_first_date),
history_last_date = format(q$history_last_date),
stringsAsFactors = FALSE
)
out[out == "NA"] <- NA
dir.create(dirname(out_path), showWarnings = FALSE, recursive = TRUE)
utils::write.csv(out, out_path, row.names = FALSE, na = "")
counted <- q[q$scorigami_status %in% c(STATUS_CONFIRMED, STATUS_SAME_DAY), , drop = FALSE]
undet <- q[q$scorigami_status == STATUS_UNDETERMINED, , drop = FALSE]
sg <- unique(counted[, c("game_date", "away_team", "home_team", "key", "scorigami_status")])
sg <- sg[order(sg$game_date), , drop = FALSE]
cat("History source: ", hist$path, "\n", sep = "")
cat("History path:   ", path_description(hist), "\n", sep = "")
cat("History rows:   ", nrow(hist$data), "\n", sep = "")
if (is.na(hist$floor)) {
cat("History floor:  unknown (summary has no first-occurrence date)\n")
cat("WARNING: the history's floor cannot be established, so a score first seen before its coverage could still be reported as confirmed.\n")
} else {
cat("History floor:  ", format(hist$floor), "\n", sep = "")
if (hist$floor > SCORIGAMI_EPOCH) {
cat(sprintf("WARNING: history starts %s, after the first NFL games (%s). A score first seen before %s will look new, so false positives are possible.\n",
hist$floor, SCORIGAMI_EPOCH, hist$floor))
}
}
cat("History ceiling:", format(hist$ceiling), "\n")
if (hist$swapped) cat("Note: ", hist$swapped, " history row(s) had loser points above winner points and were reordered.\n", sep = "")
cat("\n")
cat("Doinks loaded:  ", nrow(d), "\n", sep = "")
cat("Doink games:    ", nrow(games), "\n", sep = "")
in_range <- games$game_date <= hist$ceiling &
(is.na(hist$floor) | games$game_date >= hist$floor)
missing <- games[!is.na(games$in_history) & !games$in_history & in_range, ]
if (nrow(missing)) {
cat(sprintf("Note: %d doink game(s) inside the history's date range have no matching history row (score or date mismatch): %s\n",
nrow(missing),
paste(utils::head(paste(missing$game_date, missing$away_team, "@", missing$home_team, missing$key), 5), collapse = "; ")))
}
cat(sprintf("Doinks in Scorigami games: %d in %d game(s) (confirmed %d, same-day tie %d)\n",
nrow(counted), nrow(sg),
sum(counted$scorigami_status == STATUS_CONFIRMED),
sum(counted$scorigami_status == STATUS_SAME_DAY)))
if (nrow(undet)) {
reasons <- table(undet$status_note)
cat(sprintf("Undetermined (not counted above): %d doink(s) in %d game(s)\n",
nrow(undet), length(unique(undet$game))))
for (n in names(reasons)) cat(sprintf("  %d: %s\n", reasons[[n]], n))
}
cat("\nScorigami games:\n")
if (!nrow(sg)) cat("  (none)\n")
for (i in seq_len(nrow(sg))) {
n <- sum(counted$game == paste(sg$game_date[i], sg$away_team[i], sg$home_team[i]))
cat(sprintf("  %s  %-11s %-6s %d doink(s)%s\n", sg$game_date[i],
paste(sg$away_team[i], "@", sg$home_team[i]), sg$key[i], n,
if (sg$scorigami_status[i] == STATUS_SAME_DAY) "  [same-day tie]" else ""))
}
cat("\n")
print_table(as.list(table(counted$outcome)), "By outcome:")
print_table(as.list(table(counted$play_type)), "By play type:")
cat("\nWrote ", nrow(out), " row(s) to ", out_path, "\n", sep = "")
invisible(out)
}
